#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        f1 {
            bindings = <&kp F1>;
            key-positions = <25 26>;
            layers = <1>;
            timeout-ms = <50>;
        };

        f2 {
            bindings = <&kp F2>;
            key-positions = <26 27>;
            layers = <1>;
            timeout-ms = <50>;
        };

        f3 {
            bindings = <&kp F3>;
            key-positions = <27 28>;
            timeout-ms = <50>;
            layers = <1>;
        };

        f4 {
            bindings = <&kp F4>;
            key-positions = <28 29>;
            timeout-ms = <50>;
            layers = <1>;
        };

        f5 {
            bindings = <&kp F5>;
            key-positions = <29 30>;
            timeout-ms = <50>;
            layers = <1>;
        };

        f6 {
            bindings = <&kp F6>;
            key-positions = <30 31>;
            timeout-ms = <50>;
            layers = <1>;
        };

        f7 {
            bindings = <&kp F7>;
            key-positions = <31 32>;
            timeout-ms = <50>;
            layers = <1>;
        };

        f8 {
            bindings = <&kp F8>;
            key-positions = <32 33>;
            timeout-ms = <50>;
            layers = <1>;
        };

        f9 {
            bindings = <&kp F9>;
            key-positions = <33 34>;
            timeout-ms = <50>;
            layers = <1>;
        };

        f10 {
            bindings = <&kp F10>;
            key-positions = <34 25>;
            timeout-ms = <50>;
            layers = <1>;
        };

        f11 {
            bindings = <&kp F11>;
            key-positions = <25 26 27>;
            timeout-ms = <50>;
            layers = <1>;
        };

        f12 {
            bindings = <&kp F12>;
            key-positions = <26 27 28>;
            timeout-ms = <50>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC     &none  &none  &none     &none     &none                         &none  &none     &none      &none    &none     &kp GRAVE
&kp TAB     &kp Q  &kp W  &kp E     &kp R     &kp T                         &kp Y  &kp U     &kp I      &kp O    &kp P     &kp MINUS
&kp LCTRL   &kp A  &kp S  &kp D     &kp F     &kp G                         &kp H  &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHIFT  &kp Z  &kp X  &kp C     &kp V     &kp B  &kp LBKT     &kp RBKT  &kp N  &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp CAPS
                          &kp LALT  &kp LGUI  &mo 1  &kp SPACE    &kp RET   &mo 2  &kp BSPC  &kp RGUI
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       | BRDn | BRUp |  MUT |  Vo- |  Vo+ |                   |      |       |       |      |       |       |
            // |  F1   |  F2  |  F3  |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !   |  @   |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |      |      |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                       |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans  &kp C_BRI_DN     &kp C_BRI_UP       &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP                    &none      &none          &none         &none                 &none                  &kp LG(LC(Q))
&trans  &kp EXCLAMATION  &kp AT             &kp HASH    &kp DOLLAR    &kp PERCENT                     &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none
&trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2    &kp KP_N3   &kp KP_N4     &kp KP_N5                       &kp KP_N6  &kp KP_N7      &kp KP_N8     &kp KP_N9             &kp KP_N0              &none
&trans  &none            &kp DOUBLE_QUOTES  &none       &none         &none         &trans    &trans  &none      &none          &kp KP_COMMA  &kp KP_DOT            &kp BACKSLASH          &trans
                                            &trans      &trans        &trans        &trans    &trans  &trans     &trans         &trans
            >;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   | Bt clear | Bt 0 | Bt 1 | Bt 2 | Bt 3 | Bt 4 |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |          |      |      |      |      |      |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |          |  <-  |  v   |  ^   |  ->  |      |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |    +     |  -   |  =   |  [   |  ]   |  \   |
            //                     |      |      |      |        |  |       |          |      |      |

            bindings = <
&studio_unlock  &none  &none  &none   &kp LG(LS(N4))  &kp LS(LC(LG(N4)))                    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans          &none  &none  &none   &none           &none                                 &none       &none         &none         &none         &none         &none
&trans          &none  &none  &none   &none           &none                                 &kp LEFT    &kp DOWN      &kp UP        &kp RIGHT     &none         &none
&trans          &none  &none  &none   &none           &none               &trans    &trans  &kp PLUS    &kp MINUS     &kp KP_EQUAL  &none         &none         &trans
                              &trans  &trans          &trans              &trans    &trans  &trans      &trans        &trans
            >;
        };
    };
};
